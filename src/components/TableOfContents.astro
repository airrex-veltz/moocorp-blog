---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}
const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
<aside class="post-toc" aria-label="목차">
  <h5>Contents</h5>
  {items.length > 0 ? (
    <ol>
      {items.map((h) => (
        <li
          data-toc-link={h.slug}
          style={h.depth === 3 ? 'padding-left: 44px; font-size: 10.5px;' : ''}
        >
          <a href={`#${h.slug}`} style="color:inherit; display:block;">{h.text}</a>
        </li>
      ))}
    </ol>
  ) : (
    <ol><li style="padding-left:0; color: var(--ink-4);">—</li></ol>
  )}
  <div class="progress">
    Reading
    <div class="progress-num"><span id="toc-progress-num">0</span><span>%</span></div>
  </div>
</aside>

<script is:inline>
  function __moo_initToc() {
    const items = document.querySelectorAll('.post-toc li[data-toc-link]');
    if (!items.length) return;
    const itemBySlug = new Map();
    items.forEach((li) => itemBySlug.set(li.getAttribute('data-toc-link'), li));

    // Smooth scroll on click with offset for sticky masthead
    items.forEach((li) => {
      const a = li.querySelector('a');
      if (!a) return;
      a.addEventListener('click', (e) => {
        const slug = li.getAttribute('data-toc-link');
        const target = document.getElementById(slug);
        if (!target) return;
        e.preventDefault();
        const y = target.getBoundingClientRect().top + window.scrollY - 100;
        window.scrollTo({ top: y, behavior: 'smooth' });
        history.replaceState(null, '', '#' + slug);
      });
    });

    // Position-based active detection: pick the last heading whose top < 140
    const headings = Array.from(document.querySelectorAll('.post-body h2, .post-body h3'))
      .filter((h) => h.id && itemBySlug.has(h.id));
    if (!headings.length) return;

    let raf = 0;
    const update = () => {
      raf = 0;
      let active = headings[0].id;
      for (const h of headings) {
        if (h.getBoundingClientRect().top < 140) active = h.id;
        else break;
      }
      itemBySlug.forEach((el) => el.classList.remove('active'));
      const li = itemBySlug.get(active);
      if (li) li.classList.add('active');
    };
    const onScroll = () => {
      if (raf) return;
      raf = requestAnimationFrame(update);
    };
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', __moo_initToc);
  } else {
    __moo_initToc();
  }
</script>
