---
interface Props {
  market: 'US' | 'KR' | 'GLOBAL';
  tickers?: string[];
  sectors?: string[];
}
const { market, tickers = [], sectors = [] } = Astro.props;

const marketLabel = { US: 'US Equities', KR: 'KR Equities', GLOBAL: 'Global Markets' }[market];
const marketIcon = { US: 'public', KR: 'south_korea', GLOBAL: 'language' }[market];

const primaryTicker = tickers[0];
---
<aside class="mb-10 pb-8 border-b border-ink">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-3 text-xs uppercase tracking-[0.2em] text-ink-subtle">
      <span class="ms" style="font-size:18px" aria-hidden="true">{marketIcon}</span>
      <span>{marketLabel}</span>
      {sectors.length > 0 && <span class="text-ink-line">·</span>}
      {sectors.map((s, idx) => (
        <>
          <span>{s}</span>
          {idx < sectors.length - 1 && <span class="text-ink-line">·</span>}
        </>
      ))}
    </div>
    {primaryTicker && (
      <div class="text-right">
        <div class="text-xs uppercase tracking-widest text-ink-muted">Ticker</div>
        <div class="text-2xl sm:text-3xl font-extrabold tracking-tight tabular-nums">{primaryTicker}</div>
      </div>
    )}
  </div>
</aside>
