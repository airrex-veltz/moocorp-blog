---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { langOf, base, ui } from '../i18n/ui';

interface Props {
  current: CollectionEntry<'posts'> | CollectionEntry<'posts-en'>;
  limit?: number;
}
const { current, limit = 3 } = Astro.props;

// 같은 언어판 안에서만 추천한다 — 영문 글 밑에 한국어 글을 걸지 않는다.
const lang = langOf(Astro.url);
const all = await getCollection(lang === 'en' ? 'posts-en' : 'posts', ({ data }) => !data.draft);

function score(post: (typeof all)[number]): number {
  if (post.slug === current.slug) return -1;
  let s = 0;
  for (const t of post.data.tickers) if (current.data.tickers.includes(t)) s += 5;
  for (const sec of post.data.sectors) if (current.data.sectors.includes(sec)) s += 3;
  for (const tag of post.data.tags) if (current.data.tags.includes(tag)) s += 1;
  if (post.data.market === current.data.market) s += 1;
  const ageDays = (Date.now() - post.data.publishedAt.valueOf()) / 86400000;
  s += Math.max(0, 10 - ageDays) * 0.1;
  return s;
}

const related = all
  .map((p) => ({ post: p, score: score(p) }))
  .filter((r) => r.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, limit)
  .map((r) => r.post);

const fmtDate = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---
{related.length > 0 && (
  <section class="related">
    <h3>{ui[lang].related}</h3>
    <div class="related-grid">
      {related.map((post) => (
        <a class="article-card" href={`${base(lang)}/posts/${post.slug}`} style="border-right:0; padding:0; min-height:auto;">
          <div class="article-genre">
            <span style="font-family: var(--mono); font-size: 10px; letter-spacing: 0.14em;">{post.data.market}</span>
          </div>
          <h4 class="article-title" style="font-size:19px;">{post.data.title}</h4>
          <div class="article-meta" style="margin-top:12px;">
            <span>{post.data.author}</span>
            <span style="color: var(--ink-4)">·</span>
            <span>{fmtDate(post.data.publishedAt)}</span>
          </div>
        </a>
      ))}
    </div>
  </section>
)}
