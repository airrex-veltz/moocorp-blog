---
interface Props {
  num: number;
  kicker?: string;
  title: string;
  id?: string;
}
const { num, kicker, title, id } = Astro.props;
const padded = String(num).padStart(2, '0');
---
<div class="chapter-marker" id={id}>
  <div class="num">{padded}</div>
  <div class="meta">
    {kicker && <span class="kicker">{kicker}</span>}
    <span class="title">{title}</span>
  </div>
</div>
