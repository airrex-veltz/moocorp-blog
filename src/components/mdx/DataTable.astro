---
interface Props {
  caption?: string;
  meta?: string;
  source?: string;
}
const { caption, meta, source } = Astro.props;
---
<figure class="chart-figure">
  {caption && (
    <figcaption class="cap">
      <span class="cap-title">{caption}</span>
      {meta && <span class="cap-meta">{meta}</span>}
    </figcaption>
  )}
  <div class="ft-table-wrap" style="overflow-x:auto;">
    <slot />
  </div>
  {source && <div class="source">{source}</div>}
</figure>

<style is:global>
  .chart-figure .ft-table-wrap > table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    margin: 0;
    font-family: var(--sans);
  }
  .chart-figure .ft-table-wrap thead th {
    text-align: left;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
    font-weight: 500;
    padding: 0 16px 10px 0;
    border-bottom: 1px solid var(--ink);
  }
  .chart-figure .ft-table-wrap tbody td {
    padding: 14px 16px 14px 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    vertical-align: baseline;
  }
  .chart-figure .ft-table-wrap tbody tr:last-child td { border-bottom: 1px solid var(--ink); }
</style>
