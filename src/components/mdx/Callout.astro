---
interface Props {
  type?: 'note' | 'risk' | 'catalyst' | 'data' | 'key';
  title?: string;
  label?: string;
}
const { type = 'note', title, label } = Astro.props;

const defaultLabel = {
  note: 'Note',
  risk: 'Risk Map',
  catalyst: 'Catalyst',
  data: 'Key Data',
  key: 'Key Frame',
}[type];

const lab = label ?? title ?? defaultLabel;
---
<aside class="callout">
  <span class="lab">{lab}</span>
  <slot />
</aside>
