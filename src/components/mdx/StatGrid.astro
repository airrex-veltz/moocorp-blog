---
interface Props {
  cols?: 2 | 3 | 4;
}
const { cols = 3 } = Astro.props;
const gridClass = {
  2: 'grid-cols-1 sm:grid-cols-2',
  3: 'grid-cols-1 sm:grid-cols-2 md:grid-cols-3',
  4: 'grid-cols-2 md:grid-cols-4',
}[cols];
---
<div class={`grid gap-3 my-8 not-prose ${gridClass}`}>
  <slot />
</div>
