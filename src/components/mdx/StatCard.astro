---
interface Props {
  label: string;
  value: string;
  trend?: 'up' | 'down' | 'flat';
  delta?: string;
  context?: string;
  mono?: boolean;
}
const { label, value, trend, delta, context, mono } = Astro.props;

const dirClass = trend === 'up' ? 'pos' : trend === 'down' ? 'neg' : '';
const arrow = trend === 'up' ? '▲' : trend === 'down' ? '▼' : '';
---
<div class="statcard">
  <div class="lab">{label}</div>
  <div class={`val ${mono ? 'mono' : ''}`}>{value}</div>
  {(delta || trend) && (
    <div class={`delta ${dirClass}`}>
      {arrow && <span>{arrow}</span>}
      {delta && <span>{delta}</span>}
      {context && <span class="vs">{context}</span>}
    </div>
  )}
  {context && !delta && !trend && <div class="foot">{context}</div>}
</div>
