---
interface Props {
  title?: string;
}
const { title = '핵심 요약' } = Astro.props;
---
<section class="border border-ink p-5 my-8 not-prose">
  <div class="flex items-center gap-2 text-xs uppercase tracking-widest text-ink-subtle mb-3">
    <span class="ms" style="font-size:16px" aria-hidden="true">summarize</span>
    <span>{title}</span>
  </div>
  <div class="text-base leading-relaxed [&>ul]:list-none [&>ul]:p-0 [&>ul]:m-0 [&_li]:relative [&_li]:pl-5 [&_li]:py-1 [&_li]:before:absolute [&_li]:before:left-0 [&_li]:before:content-['—'] [&_li]:before:text-ink-muted">
    <slot />
  </div>
</section>
