---
interface Props {
  genre: 'analysis' | 'market' | 'story';
}
const { genre } = Astro.props;
---
<span class="genre-icon" aria-hidden="true">
  {genre === 'analysis' && (
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4">
      <path d="M2 13l4-5 3 3 5-7" stroke-linecap="round" stroke-linejoin="round" />
      <circle cx="13" cy="4" r="1.4" fill="currentColor" />
    </svg>
  )}
  {genre === 'market' && (
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4">
      <path d="M2 14h12M4 11V6M7 11V3M10 11V8M13 11V5" stroke-linecap="round" />
    </svg>
  )}
  {genre === 'story' && (
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4">
      <rect x="3" y="2" width="10" height="12" rx="0" />
      <path d="M5.5 6h5M5.5 9h5M5.5 12h3" stroke-linecap="round" />
    </svg>
  )}
</span>
