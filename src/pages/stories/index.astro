---
import Base from '../../layouts/Base.astro';
import GenreBadge from '../../components/GenreBadge.astro';
import { getCollection } from 'astro:content';

const stories = (await getCollection('stories', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

function getGenreFromTags(tags: string[]): "action" | "thriller" | "romance" | "melodrama" | "humor" | null {
  const genreMap: Record<string, "action" | "thriller" | "romance" | "melodrama" | "humor"> = {
    '액션': 'action', 'action': 'action',
    '스릴러': 'thriller', 'thriller': 'thriller',
    '로맨스': 'romance', 'romance': 'romance',
    '멜로': 'melodrama', 'melodrama': 'melodrama',
    '유머': 'humor', 'humor': 'humor',
  };
  for (const tag of tags) {
    const genre = genreMap[tag];
    if (genre) return genre;
  }
  return null;
}

const fmtDate = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---
<Base title="스토리" description="미국과 한국 상장사의 역사를 소설처럼 풀어낸 이야기." activeNav="stories">
  <div class="container-page page-enter">
    <header class="stories-head">
      <div class="kicker">Moo Stories · 창작 서사</div>
      <h1>회사가 들려주는 이야기</h1>
      <p class="lede">
        상장사의 역사를 액션, 스릴러, 로맨스, 멜로, 유머 5개 장르로 풀어낸 창작 서사.
      </p>
    </header>

    {stories.length > 0 ? (
      <div class="row-list" style="margin-top:0; border-top:0;">
        {stories.map((story, i) => {
          const genre = getGenreFromTags(story.data.tags);
          return (
            <a class="row" href={`/stories/${story.slug}`}>
              <div class="row-num">No. {String(i + 1).padStart(2, '0')}</div>
              <div>
                {genre && (
                  <div style="margin-bottom: 8px; display: inline-block;">
                    <GenreBadge genre={genre} size="sm" showLabel={true} />
                  </div>
                )}
                <div class="row-title">{story.data.title}</div>
                <div class="row-dek">{story.data.description}</div>
              </div>
              <div class="row-meta">
                <div>{fmtDate(story.data.publishedAt)}</div>
                {story.data.tickers.length > 0 && (
                  <div style="margin-top:4px; color:var(--ink-4);">{story.data.tickers.slice(0, 3).join(' · ')}</div>
                )}
              </div>
            </a>
          );
        })}
      </div>
    ) : (
      <p style="color: var(--ink-3); padding: 64px 0; text-align: center;">아직 발행된 스토리가 없습니다.</p>
    )}
  </div>
</Base>
