---
// 영문판 첫 화면. 한국어 첫 화면의 편집 구성을 옮기지 않고 최신순 목록 하나로 둔다 —
// 영문판은 번역이 쌓이는 속도로만 자라므로, 섹션을 나누면 빈 칸이 먼저 보인다.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const kinds = [
  { c: 'posts-en', seg: 'posts', label: 'Analysis' },
  { c: 'stories-en', seg: 'stories', label: 'Fiction' },
  { c: 'toons-en', seg: 'toons', label: 'Toons' },
  { c: 'filings-en', seg: 'filings', label: 'Filing Data' },
] as const;

const items = (await Promise.all(kinds.map(async (k) =>
  (await getCollection(k.c, ({ data }) => !data.draft)).map((e) => ({
    href: `/en/${k.seg}/${e.slug}`, label: k.label, title: e.data.title,
    description: e.data.description, market: e.data.market, at: e.data.publishedAt,
  }))
))).flat().sort((a, b) => b.at.valueOf() - a.at.valueOf() || a.href.localeCompare(b.href));

const fmtDate = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---
<Base>
  <div class="container-page page-enter" style="padding-top:48px; padding-bottom:48px;">
    <header style="margin-bottom:32px; padding-bottom:24px; border-bottom:1px solid var(--ink); max-width:var(--readable);">
      <div class="eyebrow" style="margin-bottom:12px;">English Edition</div>
      <h1 style="font-family:var(--serif); font-size:clamp(28px,4vw,44px); letter-spacing:-0.02em; font-weight:400;">Moo Research in English</h1>
      <p style="color: var(--ink-3); margin-top:12px; font-size:15px; line-height:1.6;">
        Machine translations of articles first published in Korean. The Korean original is linked from every page.
      </p>
    </header>

    {items.length === 0 ? (
      <p style="color: var(--ink-3);">Translations are on their way. <a href="/" style="text-decoration:underline;">Read the Korean edition</a>.</p>
    ) : (
      <div style="max-width:var(--readable);">
        {items.map((it) => (
          <a href={it.href} style="display:block; padding:20px 0; border-bottom:1px solid var(--rule); text-decoration:none;">
            <div style="font-family: var(--mono); font-size:10px; letter-spacing:0.14em; text-transform:uppercase; color: var(--ink-4); margin-bottom:6px;">
              {it.label} · {it.market} · {fmtDate(it.at)}
            </div>
            <h2 style="font-family:var(--serif); font-size:22px; line-height:1.3; color: var(--ink); margin:0 0 6px;">{it.title}</h2>
            <p style="font-size:14px; line-height:1.6; color: var(--ink-3); margin:0;">{it.description}</p>
          </a>
        ))}
      </div>
    )}
  </div>
</Base>
