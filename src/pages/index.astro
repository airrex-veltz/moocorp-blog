---
import Base from '../layouts/Base.astro';
import PostMeta from '../components/PostMeta.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---
<Base>
  <section class="mb-10">
    <h1 class="text-3xl font-bold tracking-tight mb-2">미국·한국 상장사 분석</h1>
    <p class="text-gray-600">
      매일 한 종목, 매주 시장 전체 — 데이터 기반 분석을 무료로 공개합니다.
    </p>
  </section>

  <ul class="divide-y divide-gray-100">
    {posts.map((post) => (
      <li class="py-6">
        <a href={`/posts/${post.slug}`} class="block group">
          <h2 class="text-xl font-semibold group-hover:text-accent transition-colors mb-1">
            {post.data.title}
          </h2>
          <p class="text-gray-600 mb-2 line-clamp-2">{post.data.description}</p>
          <PostMeta
            market={post.data.market}
            tickers={post.data.tickers}
            publishedAt={post.data.publishedAt}
            language={post.data.language}
          />
        </a>
      </li>
    ))}
  </ul>

  {posts.length === 0 && (
    <p class="text-gray-500 py-12 text-center">아직 발행된 분석이 없습니다.</p>
  )}
</Base>
