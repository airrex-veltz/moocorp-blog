---
import Base from '../layouts/Base.astro';
import PostMeta from '../components/PostMeta.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---
<Base>
  <section class="mb-14 pb-10 border-b border-ink">
    <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight leading-[1.1] mb-4">
      미국·한국 상장사 분석
    </h1>
    <p class="text-lg text-ink-subtle leading-relaxed max-w-2xl">
      매일 한 종목, 매주 시장 전체. 펀더멘털, 카탈리스트, 리스크를 데이터로 풀어냅니다.
    </p>
    <div class="mt-6 flex gap-4 text-xs uppercase tracking-widest text-ink-muted">
      <span class="inline-flex items-center gap-1">
        <span class="ms" style="font-size:16px" aria-hidden="true">trending_up</span>
        <span>매일 발행</span>
      </span>
      <span>·</span>
      <span class="inline-flex items-center gap-1">
        <span class="ms" style="font-size:16px" aria-hidden="true">verified</span>
        <span>데이터 기반</span>
      </span>
      <span>·</span>
      <span class="inline-flex items-center gap-1">
        <span class="ms" style="font-size:16px" aria-hidden="true">block</span>
        <span>투자 권유 아님</span>
      </span>
    </div>
  </section>

  {posts.length > 0 ? (
    <ul class="divide-y divide-ink-line">
      {posts.map((post) => (
        <li class="py-8 first:pt-0">
          <a href={`/posts/${post.slug}`} class="block group">
            <h2 class="text-2xl font-bold tracking-tight leading-tight mb-2 group-hover:underline underline-offset-4">
              {post.data.title}
            </h2>
            <p class="text-ink-subtle mb-3 line-clamp-2 leading-relaxed">{post.data.description}</p>
            <PostMeta
              market={post.data.market}
              tickers={post.data.tickers}
              publishedAt={post.data.publishedAt}
              language={post.data.language}
            />
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p class="text-ink-muted py-16 text-center">아직 발행된 분석이 없습니다.</p>
  )}
</Base>
