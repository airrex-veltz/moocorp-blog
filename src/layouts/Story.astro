---
import Base from './Base.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import StoryHero from '../components/mdx/StoryHero.astro';
import StoryEnd from '../components/mdx/StoryEnd.astro';
import HeroImage from '../components/mdx/HeroImage.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  story: CollectionEntry<'stories'>;
}

const { story } = Astro.props;
const { data, body } = story;

const wordCount = body ? body.replace(/\s+/g, '').length : 0;
const readingTime = Math.max(1, Math.round(wordCount / 600));

const marketLabel = { US: 'US', KR: 'KR', GLOBAL: 'GLOBAL' }[data.market];
const dateString = data.publishedAt.toLocaleDateString(data.language === 'ko' ? 'ko-KR' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Helper to extract genre from tags
function getGenreFromTags(tags: string[]): "action" | "thriller" | "romance" | "melodrama" | "humor" | null {
  const genreMap: Record<string, "action" | "thriller" | "romance" | "melodrama" | "humor"> = {
    '액션': 'action',
    'action': 'action',
    '스릴러': 'thriller',
    'thriller': 'thriller',
    '로맨스': 'romance',
    'romance': 'romance',
    '멜로': 'melodrama',
    'melodrama': 'melodrama',
    '유머': 'humor',
    'humor': 'humor',
  };

  for (const tag of tags) {
    const genre = genreMap[tag];
    if (genre) return genre;
  }
  return null;
}

const genre = getGenreFromTags(data.tags);
---
<Base
  title={data.title}
  description={data.description}
  language={data.language}
  publishedAt={data.publishedAt}
  updatedAt={data.updatedAt}
  schemaType="Article"
  tickers={data.tickers}
  tags={data.tags}
>
  <ReadingProgress />

  <article>
    {data.heroImage && data.heroImage.url && (
      <HeroImage
        src={data.heroImage.url}
        alt={data.heroImage.alt || ''}
        attribution={data.heroImage.attribution || ''}
        sourceUrl={data.heroImage.sourceUrl}
        colorTreatment={data.heroImage.colorTreatment || 'color'}
      />
    )}

    {genre && (
      <StoryHero
        genre={genre}
        market={marketLabel}
        tickers={data.tickers}
        title={data.title}
        date={dateString}
        dateISO={data.publishedAt.toISOString()}
        description={data.description}
        tags={data.tags}
        readingTime={readingTime}
      />
    )}

    <div class="ad-slot ad-slot-top"></div>

    <div class="prose prose-ink prose-story max-w-none">
      <slot />
      <StoryEnd />
    </div>

    <div class="ad-slot ad-slot-bottom"></div>

    <footer class="mt-16 pt-8 border-t border-ink-line">
      <p class="text-sm text-ink-muted leading-relaxed">
        본 스토리는 공개된 회사 역사 자료를 바탕으로 한 창작 서사이며, 사실과 다를 수 있습니다.
        투자 권유나 기업 평가가 아닙니다.
      </p>
    </footer>

    <nav class="mt-12 pt-6 border-t border-ink-line flex justify-between text-sm">
      <a href="/stories" class="inline-flex items-center gap-2 hover:underline underline-offset-4 hover:-translate-x-1 transition-transform duration-150">
        <span class="ms" aria-hidden="true">arrow_back</span>
        <span>다른 스토리</span>
      </a>
      <a href="/" class="hover:underline underline-offset-4">홈</a>
    </nav>
  </article>
</Base>
