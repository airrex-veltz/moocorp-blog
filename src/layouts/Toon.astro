---
import Base from './Base.astro';
import RelatedStories from '../components/RelatedStories.astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { langOf, base, home, ui } from '../i18n/ui';

interface Props {
  toon: CollectionEntry<'toons'> | CollectionEntry<'toons-en'>;
}

const { toon } = Astro.props;
const { data } = toon;
const lang = langOf(Astro.url);
const L = ui[lang];
const b = base(lang);
const alternate = lang === 'en'
  ? `/toons/${toon.slug}`
  : ((await getCollection('toons-en')).some((e) => e.slug === toon.slug) ? `/en/toons/${toon.slug}` : undefined);

const dateString = data.publishedAt.toLocaleDateString(data.language === 'ko' ? 'ko-KR' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<Base
  title={data.title}
  description={data.description}
  language={data.language}
  publishedAt={data.publishedAt}
  updatedAt={data.updatedAt}
  schemaType="Article"
  tickers={data.tickers}
  tags={data.tags}
  activeNav="toons"
  alternate={alternate}
>
  <div class="container-page page-enter" style="padding-top:48px; padding-bottom:48px; max-width: 880px;">
    <article>
      <header style="text-align:center; margin-bottom:32px;">
        <div style="font-family:var(--mono); font-size:11px; letter-spacing:0.12em; text-transform:uppercase; color:var(--ink-4); margin-bottom:12px;">
          Moo Toons <span class="beta-badge" style="margin-left:4px;">Beta</span>
        </div>
        <h1 style="font-family:var(--serif); font-size:36px; line-height:1.2; letter-spacing:-0.01em; color:var(--ink); margin-bottom:12px;">
          {data.title}
        </h1>
        <p style="font-size:15px; line-height:1.6; color:var(--ink-3); max-width:640px; margin:0 auto;">
          {data.description}
        </p>
        <div style="margin-top:16px; font-family:var(--mono); font-size:10px; letter-spacing:0.12em; text-transform:uppercase; color:var(--ink-4);">
          {dateString}
          {data.tickers.length > 0 && <span style="margin-left:8px;">· {data.tickers.slice(0, 3).join(' · ')}</span>}
        </div>
      </header>

      <div class="toon-beta-bar" role="note" style="max-width:720px; margin-left:auto; margin-right:auto;">
        <strong>Beta</strong>
        <span>{L.toonBeta}</span>
      </div>

      <div class="prose prose-story" style="max-width:720px; margin:0 auto;">
        <slot />
      </div>

      {data.sourceStorySlug && (
        <div style="margin-top:48px; padding-top:24px; border-top:1px solid var(--rule); text-align:center;">
          <a href={`${b}/stories/${data.sourceStorySlug}`} style="font-family:var(--mono); font-size:11px; letter-spacing:0.08em; text-transform:uppercase; color:var(--accent);">
            {L.sourceStory}
          </a>
        </div>
      )}

      <RelatedStories current={toon} />

      <footer style="margin-top:64px; padding-top:32px; border-top:1px solid var(--rule);">
        <p style="font-size:13px; color: var(--ink-3); line-height:1.7; text-align:center;" set:html={L.toonNotice(b)} />
      </footer>

      <nav style="margin-top:48px; padding-top:24px; border-top:1px solid var(--rule); display:flex; justify-content:space-between; font-family: var(--mono); font-size:11px; letter-spacing:0.12em; text-transform:uppercase;">
        <a href={lang === 'ko' ? '/toons' : home(lang)} style="color: var(--ink-3); display:inline-flex; align-items:center; gap:8px;">
          <span aria-hidden="true">←</span>
          <span>{L.moreToons}</span>
        </a>
        <a href={lang === 'ko' ? '/stories' : home(lang)} style="color: var(--ink-3);">{L.toStories}</a>
      </nav>
    </article>
  </div>
</Base>
