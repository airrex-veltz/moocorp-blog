---
import Base from './Base.astro';
import PostMeta from '../components/PostMeta.astro';
import PostHero from '../components/PostHero.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import TableOfContents from '../components/TableOfContents.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import HeroImage from '../components/mdx/HeroImage.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
  headings?: { depth: number; slug: string; text: string }[];
}

const { post, headings = [] } = Astro.props;
const { data, body } = post;

const wordCount = body ? body.replace(/\s+/g, '').length : 0;
const readingTime = Math.max(1, Math.round(wordCount / 500));
---
<Base
  title={data.title}
  description={data.description}
  language={data.language}
  publishedAt={data.publishedAt}
  updatedAt={data.updatedAt}
  schemaType="Article"
  tickers={data.tickers}
  tags={data.tags}
>
  <ReadingProgress />
  <TableOfContents headings={headings} />

  <article>
    {data.heroImage && data.heroImage.url && (
      <HeroImage
        src={data.heroImage.url}
        alt={data.heroImage.alt || ''}
        attribution={data.heroImage.attribution || ''}
        sourceUrl={data.heroImage.sourceUrl}
        colorTreatment={data.heroImage.colorTreatment || 'desaturate'}
      />
    )}

    <PostHero
      market={data.market}
      tickers={data.tickers}
      sectors={data.sectors}
    />

    <header class="mb-12">
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-[-0.025em] leading-[1.05] mb-6">
        {data.title}
      </h1>
      <p class="text-xl text-ink-subtle leading-relaxed mb-6 max-w-[60ch]">{data.description}</p>
      <PostMeta
        market={data.market}
        tickers={data.tickers}
        publishedAt={data.publishedAt}
        language={data.language}
        readingTime={readingTime}
      />
    </header>

    <div class="ad-slot ad-slot-top"></div>

    <div class="prose prose-ink prose-article max-w-none">
      <slot />
    </div>

    <div class="ad-slot ad-slot-bottom"></div>

    {data.tags.length > 0 && (
      <footer class="mt-12 pt-8 border-t border-ink-line">
        <div class="text-xs uppercase tracking-widest text-ink-muted mb-3">관련 태그</div>
        <div class="flex flex-wrap gap-2">
          {data.tags.map((tag) => (
            <a href={`/tags/${tag}`} class="pill-subtle hover:border-ink hover:text-ink transition-colors">
              <span>#{tag}</span>
            </a>
          ))}
        </div>
      </footer>
    )}

    <RelatedPosts current={post} />

    <nav class="mt-12 pt-6 border-t border-ink-line">
      <a href="/" class="inline-flex items-center gap-2 text-sm hover:underline underline-offset-4 hover:-translate-x-1 transition-transform duration-150">
        <span class="ms" aria-hidden="true">arrow_back</span>
        <span>다른 분석 보기</span>
      </a>
    </nav>
  </article>
</Base>
