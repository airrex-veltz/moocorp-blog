---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  language?: 'ko' | 'en';
  publishedAt?: Date;
}

const SITE_NAME = 'Moo Corp';
const DEFAULT_TITLE = 'Moo Corp — 미국·한국 상장사 분석';
const DEFAULT_DESC = '미국과 한국 상장사 동향을 매일 분석합니다. 펀더멘털, 카탈리스트, 리스크를 한 곳에.';

const {
  title,
  description = DEFAULT_DESC,
  image,
  language = 'ko',
  publishedAt,
} = Astro.props;

const fullTitle = title ? `${title} · ${SITE_NAME}` : DEFAULT_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = image ? new URL(image, Astro.site).toString() : new URL('/og-default.png', Astro.site).toString();
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content={publishedAt ? 'article' : 'website'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={language === 'ko' ? 'ko_KR' : 'en_US'} />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" as="style" crossorigin
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <link rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,300..700,0..1,-50..200" />
  </head>
  <body>
    <header class="border-b border-ink">
      <div class="container-narrow flex items-center justify-between py-5">
        <a href="/" class="flex items-baseline gap-2 hover:opacity-70 transition-opacity">
          <span class="text-2xl font-extrabold tracking-tight">Moo Corp</span>
          <span class="hidden sm:inline text-xs text-ink-muted uppercase tracking-widest">Research</span>
        </a>
        <nav class="text-sm flex gap-5 items-center">
          <a href="/" class="hover:underline underline-offset-4">분석</a>
          <a href="/tags" class="hover:underline underline-offset-4">태그</a>
          <a href="/about" class="hover:underline underline-offset-4">소개</a>
          <a href="/rss.xml" aria-label="RSS" class="hover:opacity-60 transition-opacity">
            <span class="ms" aria-hidden="true">rss_feed</span>
          </a>
        </nav>
      </div>
    </header>

    <main class="container-narrow py-12">
      <slot />
    </main>

    <footer class="border-t border-ink mt-24">
      <div class="container-narrow py-10">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-sm">
          <div>
            <div class="text-xs uppercase tracking-widest text-ink-muted mb-2">About</div>
            <p class="text-ink-subtle leading-relaxed">미국과 한국 상장사 동향을 매일 분석합니다.</p>
          </div>
          <div>
            <div class="text-xs uppercase tracking-widest text-ink-muted mb-2">Links</div>
            <ul class="space-y-1">
              <li><a href="/" class="hover:underline underline-offset-4">홈</a></li>
              <li><a href="/about" class="hover:underline underline-offset-4">소개</a></li>
              <li><a href="/privacy" class="hover:underline underline-offset-4">개인정보처리방침</a></li>
              <li><a href="/disclaimer" class="hover:underline underline-offset-4">면책조항</a></li>
              <li><a href="/rss.xml" class="hover:underline underline-offset-4">RSS</a></li>
            </ul>
          </div>
          <div>
            <div class="text-xs uppercase tracking-widest text-ink-muted mb-2">Disclosure</div>
            <p class="text-ink-subtle leading-relaxed text-xs">본 사이트의 분석은 정보 제공 목적이며, 투자 권유가 아닙니다.</p>
          </div>
        </div>
        <div class="mt-8 pt-6 border-t border-ink-line flex flex-col sm:flex-row sm:justify-between gap-2 text-xs text-ink-muted">
          <span>© {year} Moo Corp Research</span>
          <span>Made with Astro</span>
        </div>
      </div>
    </footer>
  </body>
</html>
