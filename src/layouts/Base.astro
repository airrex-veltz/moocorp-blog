---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  language?: 'ko' | 'en';
  publishedAt?: Date;
  updatedAt?: Date;
  schemaType?: 'WebSite' | 'Article';
  tickers?: string[];
  tags?: string[];
  showTicker?: boolean;
  activeNav?: 'today' | 'archive' | 'stories' | 'tags' | 'about';
}

const SITE_NAME = 'Moo Research';
const SITE_URL = 'https://moo.veltzcloud.com';
const DEFAULT_TITLE = 'Moo Research — 미국·한국 상장사 분석';
const DEFAULT_DESC = '미국과 한국 상장사 동향을 매일 분석합니다. 펀더멘털, 카탈리스트, 리스크를 한 곳에.';

const {
  title,
  description = DEFAULT_DESC,
  image,
  language = 'ko',
  publishedAt,
  updatedAt,
  schemaType = publishedAt ? 'Article' : 'WebSite',
  tickers = [],
  tags = [],
  showTicker = true,
  activeNav = 'today',
} = Astro.props;

const fullTitle = title ? `${title} · ${SITE_NAME}` : DEFAULT_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = image ? new URL(image, Astro.site).toString() : new URL('/og-default.svg', Astro.site).toString();
const year = new Date().getFullYear();

// Volume / Issue auto-derivation: site started 2024-01-01.
// Vol = years since start (Roman numerals). Issue = ISO week of year.
const SITE_START = new Date('2024-01-01T00:00:00Z');
const now = new Date();
const yearsSince = now.getUTCFullYear() - SITE_START.getUTCFullYear() + 1;
const toRoman = (n: number) => {
  const m: [number, string][] = [[10, 'X'], [9, 'IX'], [5, 'V'], [4, 'IV'], [1, 'I']];
  let s = '';
  for (const [v, sym] of m) while (n >= v) { s += sym; n -= v; }
  return s;
};
const vol = toRoman(yearsSince);
// ISO week
const d = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()));
const dayNum = (d.getUTCDay() + 6) % 7;
d.setUTCDate(d.getUTCDate() - dayNum + 3);
const firstThursday = new Date(Date.UTC(d.getUTCFullYear(), 0, 4));
const issue = 1 + Math.round(((d.getTime() - firstThursday.getTime()) / 86400000 - 3 + ((firstThursday.getUTCDay() + 6) % 7)) / 7);
const dateLabel = `${now.getFullYear()}.${String(now.getMonth() + 1).padStart(2, '0')}.${String(now.getDate()).padStart(2, '0')} · Vol. ${vol} · No. ${issue}`;

const googleVerify = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const naverVerify = import.meta.env.PUBLIC_NAVER_SITE_VERIFICATION;

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  alternateName: 'Moo Research',
  url: SITE_URL,
  description: DEFAULT_DESC,
  inLanguage: 'ko-KR',
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: `${SITE_URL}/?q={search_term_string}` },
    'query-input': 'required name=search_term_string',
  },
};

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_NAME,
  alternateName: 'Moo Research',
  url: SITE_URL,
  logo: `${SITE_URL}/favicon.svg`,
  description: DEFAULT_DESC,
};

const articleSchema = publishedAt && schemaType === 'Article' ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  image: ogImage,
  datePublished: publishedAt.toISOString(),
  dateModified: (updatedAt ?? publishedAt).toISOString(),
  author: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
  publisher: { '@type': 'Organization', name: SITE_NAME, logo: { '@type': 'ImageObject', url: `${SITE_URL}/favicon.svg` } },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  inLanguage: language === 'ko' ? 'ko-KR' : 'en-US',
  keywords: [...tickers, ...tags].join(', '),
} : null;

const navLinks: Array<{ id: NonNullable<Props['activeNav']>; href: string; label: string }> = [
  { id: 'today', href: '/', label: 'Today' },
  { id: 'archive', href: '/archive', label: 'Archive' },
  { id: 'stories', href: '/stories', label: 'Stories' },
  { id: 'tags', href: '/tags', label: 'Tags' },
  { id: 'about', href: '/about', label: 'About' },
];
---
<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {googleVerify && <meta name="google-site-verification" content={googleVerify} />}
    {naverVerify && <meta name="naver-site-verification" content={naverVerify} />}
    <meta name="robots" content="index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1" />
    <meta name="googlebot" content="index,follow" />

    <meta property="og:type" content={publishedAt ? 'article' : 'website'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={language === 'ko' ? 'ko_KR' : 'en_US'} />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" as="style" crossorigin
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <link rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,300..700;1,8..60,400&family=IBM+Plex+Sans+KR:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" />
    <link rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,300..700,0..1,-50..200" />

    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}

    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('moo-theme');
          const sysDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const dark = stored ? stored === 'dark' : sysDark;
          if (dark) document.documentElement.setAttribute('data-theme', 'dark');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <header class="masthead">
      <div class="container-page masthead-inner">
        <div class="masthead-date">{dateLabel}</div>
        <a href="/" class="masthead-logo" aria-label={SITE_NAME}>
          <span>Moo</span>
          <span class="dot"></span>
          <span style="color: var(--ink-3); font-style: italic; font-size: 16px;">Research</span>
        </a>
        <div class="masthead-actions">
          <a class="icon-btn" href="/rss.xml" aria-label="RSS feed" title="RSS">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 11a9 9 0 0 1 9 9" />
              <path d="M4 4a16 16 0 0 1 16 16" />
              <circle cx="5" cy="19" r="1" fill="currentColor" />
            </svg>
          </a>
          <button id="theme-toggle" class="icon-btn" aria-label="Toggle theme" type="button">
            <svg class="i-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4" />
            </svg>
            <svg class="i-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" style="display:none">
              <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" />
            </svg>
          </button>
          <a href="#" class="subscribe-btn" onclick="event.preventDefault();alert('구독 — placeholder');return false;">Subscribe</a>
        </div>
      </div>
      <div class="container-page subnav">
        <nav class="subnav-inner" aria-label="Primary">
          {navLinks.map((l) => (
            <a class={`subnav-link ${activeNav === l.id ? 'active' : ''}`} href={l.href}>{l.label}</a>
          ))}
          <span style="flex:1"></span>
          <span style="color: var(--ink-4); letter-spacing: 0.04em;">EST. 2024 · SEOUL</span>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container-page footer-inner">
        <div class="footer-brand">
          <div class="footer-logo">Moo Research</div>
          <p class="footer-tag">
            상장사를 한 단계 더 깊이 읽기 위한 에디토리얼.<br />
            매주 화·금 발행. 광고 없음.
          </p>
        </div>
        <div>
          <h4>Sections</h4>
          <ul>
            <li><a href="/">Today</a></li>
            <li><a href="/archive">Archive</a></li>
            <li><a href="/stories">Stories</a></li>
            <li><a href="/tags">Tags</a></li>
          </ul>
        </div>
        <div>
          <h4>About</h4>
          <ul>
            <li><a href="/about">About</a></li>
            <li><a href="/about">Methodology</a></li>
            <li><a href="mailto:hello@moocorp.example">Contact</a></li>
            <li><a href="/rss.xml">RSS</a></li>
          </ul>
        </div>
        <div>
          <h4>Legal</h4>
          <ul>
            <li><a href="/privacy">Privacy</a></li>
            <li><a href="/disclaimer">Disclaimer</a></li>
            <li><a href="/disclaimer">Terms</a></li>
          </ul>
        </div>
      </div>
      <div class="container-page footer-base">
        <span>© {year} MOO RESEARCH · ALL RIGHTS RESERVED</span>
        <span>NOT INVESTMENT ADVICE · SEE DISCLAIMER</span>
      </div>
    </footer>

    <Analytics />
    <SpeedInsights />

    <script is:inline>
      (() => {
        const btn = document.getElementById('theme-toggle');
        if (!btn) return;
        const sun = btn.querySelector('.i-sun');
        const moon = btn.querySelector('.i-moon');
        const sync = () => {
          const dark = document.documentElement.getAttribute('data-theme') === 'dark';
          if (sun) sun.style.display = dark ? 'none' : '';
          if (moon) moon.style.display = dark ? '' : 'none';
        };
        sync();
        btn.addEventListener('click', () => {
          const dark = document.documentElement.getAttribute('data-theme') === 'dark';
          const next = dark ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          try { localStorage.setItem('moo-theme', next); } catch (e) {}
          sync();
        });
      })();
    </script>
  </body>
</html>
